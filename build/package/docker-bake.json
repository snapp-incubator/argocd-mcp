{
  "group": { "default": { "targets": ["argocd-mcp"] } },
  "variable": { "TAG": { "default": "latest" }, "SHA": { "default": "dev" } },
  "target": {
    "argocd-mcp": {
      "dockerfile": "Dockerfile",
      "context": ".",
      "platforms": ["linux/amd64", "linux/arm64"],
      "args": { "VERSION": "${TAG}", "COMMIT": "${SHA}" },
      "tags": [
        "ghcr.io/snapp-incubator/argocd-mcp:${TAG}",
        "ghcr.io/snapp-incubator/argocd-mcp:sha-${SHA}"
      ],
      "cache-from": ["type=gha,scope=argocd-mcp"],
      "cache-to": ["type=gha,mode=max,scope=argocd-mcp"]
    }
  }
}
